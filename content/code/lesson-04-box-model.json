   "uz": "Bir qatorda 3 ta kartochka yasa: nom, narx, tugma. padding, border va bir xil margin bilan.",
   "en": "Make 3 cards in a row: name, price, button. With padding, border and equal margin."
  },
  "files": {
   "index.html": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Мой сайт</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  \n</body>\n</html>\n",
   "style.css": ""
  },
  "steps": [
   {
    "file": "style.css",
    "re": "\\*\\s*\\{[^}]*box-sizing\\s*:\\s*border-box",
    "say": {
     "ru": "Начни CSS с `* { box-sizing: border-box; }`",
     "uz": "CSS ni `* { box-sizing: border-box; }` bilan boshla",
     "en": "Start CSS with `* { box-sizing: border-box; }`"
    },
    "show": "* {\n  box-sizing: border-box;\n}"
   },
   {
    "file": "index.html",
    "re": "(<div class=\"card\">[\\s\\S]*?<button>[\\s\\S]*?</div>[\\s\\S]*){3}",
