     "ru": "В HTML три `<div class=\"card\">`: заголовок, цена и `<button>`",
     "uz": "HTML da uchta `<div class=\"card\">`: sarlavha, narx va `<button>`",
     "en": "In HTML three `<div class=\"card\">`: title, price and a `<button>`"
    },
    "show": "<div class=\"card\">\n  <h3>Кроссовки</h3>\n  <p>450 000 сум</p>\n  <button>Купить</button>\n</div>"
   },
   {
    "file": "style.css",
    "re": "\\.card\\s*\\{[^}]*padding\\s*:\\s*\\d+px",
    "say": {
     "ru": "`.card` — padding, чтобы текст не прилипал",
     "uz": "`.card` — matn chetga yopishmasligi uchun padding",
     "en": "`.card` — padding so the text doesn't stick"
    },
    "show": ".card {\n  padding: 16px;\n}"
   },
   {
    "file": "style.css",
    "re": "\\.card\\s*\\{[^}]*border\\s*:\\s*\\d+px",
    "say": {
     "ru": "`.card` — рамка border",
     "uz": "`.card` — border ramka",
     "en": "`.card` — a border"
    },
    "show": "border: 2px solid #ddd;"
   },
   {
    "file": "style.css",
    "re": "\\.card\\s*\\{[^}]*margin\\s*:\\s*\\d+px",
    "say": {
     "ru": "Одинаковое расстояние между карточками — margin",
     "uz": "Kartochkalar orasida bir xil masofa — margin",
     "en": "Equal space between cards — margin"
    },
    "show": "margin: 10px;"
   },
   {
    "file": "style.css",
    "re": "\\.card\\s*\\{[^}]*display\\s*:\\s*inline-block",
    "say": {
     "ru": "Чтобы стояли в ряд: `display: inline-block; width: 250px;`",
     "uz": "Bir qatorda turishi uchun: `display: inline-block; width: 250px;`",
     "en": "To stand in a row: `display: inline-block; width: 250px;`"
    },
    "show": "display: inline-block;\nwidth: 250px;"
