     "intro": {
      "ru": "Объяви переменную --accent так, чтобы заголовок .title мог её использовать, и покрась им заголовок.",
      "uz": "--accent o'zgaruvchisini .title sarlavhasi foydalana oladigan qilib e'lon qil va uni shu rangga bo'ya.",
      "en": "Declare --accent so the .title heading can use it, and color the heading with it."
     },
     "allow": [
      "html",
      "css"
     ],
     "files": {
      "index.html": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Мой сайт</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <h2 class=\"title\">Заголовок</h2>\n</body>\n</html>\n",
      "style.css": ""
     },
     "steps": [
      {
       "file": "style.css",
       "re": ":root\\s*\\{[^}]*--accent\\s*:\\s*[^;}]+",
       "say": {
        "ru": "Объяви переменную глобально: `:root { --accent: … }`",
        "uz": "O'zgaruvchini global e'lon qil: `:root { --accent: … }`",
        "en": "Declare the variable globally: `:root { --accent: … }`"
       }
      },
      {
       "file": "style.css",
       "re": "\\.title\\s*\\{[^}]*color\\s*:\\s*var\\(\\s*--accent\\s*\\)",
       "say": {
        "ru": "Используй её: `.title { color: var(--accent); }`",
        "uz": "Undan foydalan: `.title { color: var(--accent); }`",
        "en": "Use it: `.title { color: var(--accent); }`"
       }
      }
     ],
     "sample": ":root {\n  --accent: red;\n}\n.title {\n  color: var(--accent);\n}",
     "open": "style.css"
    }
   },
