      "ru": "Кратные трём",
      "uz": "Uchga karralilar",
      "en": "Multiples of three"
     },
     "intro": {
      "ru": "Выведи в консоль числа от 1 до 9, которые делятся на 3 без остатка.",
      "uz": "1 dan 9 gacha 3 ga qoldiqsiz bo'linadigan sonlarni konsolga chiqar.",
      "en": "Print to the console the numbers from 1 to 9 that divide by 3 with no remainder."
     },
     "allow": [
      "js"
     ],
     "files": {
      "script.js": "// Напиши код здесь\n"
     },
     "steps": [
      {
       "file": "script.js",
       "re": "for\\s*\\(\\s*let\\s+i\\s*=\\s*1\\s*;\\s*i\\s*(<\\s*10|<=\\s*9)\\s*;\\s*i\\+\\+\\s*\\)",
       "say": {
        "ru": "Цикл `for (let i = 1; i < 10; i++)`",
        "uz": "Tsikl `for (let i = 1; i < 10; i++)`",
        "en": "A loop `for (let i = 1; i < 10; i++)`"
       }
      },
      {
       "file": "script.js",
       "re": "if\\s*\\(\\s*i\\s*%\\s*3\\s*===?\\s*0\\s*\\)",
       "say": {
        "ru": "Условие через остаток: `if (i % 3 === 0)`",
        "uz": "Qoldiq orqali shart: `if (i % 3 === 0)`",
        "en": "A remainder condition: `if (i % 3 === 0)`"
       }
      },
      {
       "file": "script.js",
       "re": "console\\.log\\(\\s*i\\s*\\)",
       "say": {
        "ru": "Выведи число: `console.log(i)`",
        "uz": "Sonni chiqar: `console.log(i)`",
        "en": "Print the number: `console.log(i)`"
       }
      }
     ],
     "sample": "for (let i = 1; i < 10; i++) {\n  if (i % 3 === 0) {\n    console.log(i);\n  }\n}"
    }
   },
