      "en": "A grade from points"
     },
     "intro": {
      "ru": "По переменной score выведи «Отлично» (от 90), «Хорошо» (от 70) или «Подтянуть». Важен порядок проверок!",
      "uz": "score o'zgaruvchisi bo'yicha «A'lo» (90 dan), «Yaxshi» (70 dan) yoki «Tortish kerak» chiqar. Tekshiruvlar tartibi muhim!",
      "en": "Print «Excellent» (90+), «Good» (70+) or «Needs work» from score. The order of checks matters!"
     },
     "allow": [
      "js"
     ],
     "files": {
      "script.js": "// Напиши код здесь\nconst score = 95;\n"
     },
     "steps": [
      {
       "file": "script.js",
       "re": "if\\s*\\(\\s*score\\s*>=\\s*90\\s*\\)[\\s\\S]*else\\s+if\\s*\\(\\s*score\\s*>=\\s*70\\s*\\)",
       "say": {
        "ru": "Сначала строгое условие `if (score >= 90)`, потом `else if (score >= 70)`",
        "uz": "Avval qat'iy shart `if (score >= 90)`, keyin `else if (score >= 70)`",
        "en": "The strict condition first `if (score >= 90)`, then `else if (score >= 70)`"
       }
      },
      {
       "file": "script.js",
       "re": "else\\s*\\{[\\s\\S]*console\\.log",
       "say": {
        "ru": "И `else` для остального, везде — `console.log(…)`",
        "uz": "Va qolgani uchun `else`, hamma joyda — `console.log(…)`",
        "en": "And `else` for the rest, with `console.log(…)` everywhere"
       }
      }
     ],
     "sample": "if (score >= 90) {\n  console.log(\"Отлично\");\n} else if (score >= 70) {\n  console.log(\"Хорошо\");\n} else {\n  console.log(\"Подтянуть\");\n}"
    }
   },
