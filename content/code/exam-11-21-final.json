     "files": {
      "index.html": "<!DOCTYPE html>\n<html>\n<head>\n  <title>JS</title>\n</head>\n<body>\n  <button class=\"btn\">Нажми</button>\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
