    "task": {
     "title": {
      "ru": "Форма без перезагрузки",
      "uz": "Qayta yuklanmaydigan forma",
      "en": "A form without a reload"
     },
     "intro": {
      "ru": "Форма form не должна перезагружать страницу при отправке: обработай submit и отмени действие по умолчанию.",
      "uz": "form yuborilganda sahifani qayta yuklamasin: submit ni qayta ishla va standart amalni bekor qil.",
      "en": "The form must not reload the page on submit: handle submit and cancel the default action."
     },
     "allow": [
      "html",
      "css",
      "js"
     ],
     "files": {
      "index.html": "<!DOCTYPE html>\n<html>\n<head>\n  <title>JS</title>\n</head>\n<body>\n  <form class=\"form\">\n    <input placeholder=\"Имя\">\n    <button>Отправить</button>\n  </form>\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
      "script.js": "// Напиши код здесь\nconst form = document.querySelector(\".form\");\n"
     },
     "steps": [
      {
       "file": "script.js",
       "re": "form\\.addEventListener\\(\\s*[\"\\']submit[\"\\']\\s*,\\s*(function\\s*\\(\\s*e\\s*\\)|\\(?\\s*e\\s*\\)?\\s*=>)",
       "say": {
        "ru": "Слушай `\"submit\"` и прими `e`",
        "uz": "`\"submit\"` ni tingla va `e` ni ol",
        "en": "Listen for `\"submit\"` and take `e`"
       }
      },
      {
       "file": "script.js",
       "re": "e\\.preventDefault\\(\\s*\\)",
       "say": {
        "ru": "Отмени перезагрузку: `e.preventDefault();`",
        "uz": "Qayta yuklanishni bekor qil: `e.preventDefault();`",
        "en": "Cancel the reload: `e.preventDefault();`"
       }
      }
     ],
     "sample": "form.addEventListener(\"submit\", function (e) {\n  e.preventDefault();\n});",
     "open": "script.js"
    }
   },
