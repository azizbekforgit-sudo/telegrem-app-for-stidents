        "slides": [
          {
            "emoji": "⚡",
            "text": "Avval elementlarni qo'lda o'zgartirardik. Lekin sayt foydalanuvchi harakatiga javob berishi kerak — bu **hodisa**."
          },
          {
            "text": "Tugma bosildi — matn o'zgardi:",
            "code": "const button = document.querySelector(\"button\");\nconst text = document.querySelector(\"p\");\n\nbutton.addEventListener(\"click\", function () {\n  text.textContent = \"Tugma bosildi!\";\n});"
