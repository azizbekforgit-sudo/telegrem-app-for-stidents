        "title": "Git and GitHub",
        "slides": [
          {
            "emoji": "🌿",
            "text": "**Git** is a program on your computer that keeps the history of changes. **GitHub** is a site where projects are stored online."
          },
          {
            "quote": true,
            "text": "Git is the program, GitHub is the place where you publish the result."
          }
        ],
        "check": [
          {
            "type": "choice",
            "topic": "Git and GitHub",
